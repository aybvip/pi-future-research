# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# Node (only if reference scripts are added later)
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (only if analysis notebooks are added later)
__pycache__/
*.py[cod]
.venv/
venv/

# Local data dumps — must never be committed, except curated datasets explicitly
# published as part of a study. A curated dataset is small, hashed in a manifest,
# and is listed in SOURCES.md §3.
data/*
*.csv
*.ndjson
*.sqlite
*.db
!**/examples/**/*.csv

# Published ledger-cadence dataset (RES-013) — curated, hashed, reproducible.
!data/ledger-cadence-2026-10-25/
!data/ledger-cadence-2026-10-25/**
!data/ledger-cadence-2026-10-25/*.csv

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Build output
_site/
dist/
build/
.cache/

# Local notes
NOTES.local.md
